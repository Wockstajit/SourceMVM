        m_vNormal = { m_nType = "PVEC_TYPE_CP_VALUE" m_nControlPoint = 2 }
        m_flFOVAngle = { m_nType = "PF_TYPE_LITERAL" m_flLiteralValue = 150.0 }
        m_flBarnNearSizeX = { m_nType = "PF_TYPE_LITERAL" m_flLiteralValue = 64.0 }
        m_flBarnNearSizeY = { m_nType = "PF_TYPE_LITERAL" m_flLiteralValue = 64.0 }
