.env
.env.*
!.env.example
*.secret
*.secrets
*.pfx
*.p12
*.pem
*.key
*.kdbx
*.credentials.json
*.secrets.json
*.webhook.json
*.local.json
*.local.yml
*.local.yaml
*.local.ini
*.local.toml
*.local.h
*.local.hpp

