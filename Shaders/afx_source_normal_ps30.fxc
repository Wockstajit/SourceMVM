// SOURCE:MVM: HLAE's depth draw supplies the INTZ sampler and inverse projection.
const float4 nearFar : register(c0);
const float4x4 inverseProjection : register(c1);
const float4 texel : register(c5); // width, height
sampler depthTex : register(s0);
sampler worldDepthTex : register(s1);
const float4 passParams : register(c6); // normal output, subject mask
static const float4 camera = float4(0,0,0,0);
static const float4 forward = float4(0,0,1,0);
static const float4 right = float4(1,0,0,0);
static const float4 up = float4(0,1,0,0);

float LoadRaw(sampler t,int2 px) {
    return tex2Dlod(t,float4((float2(px)+0.5)/texel.xy,0,0)).r;
}
float ViewDistance(float raw) {
    // As in CS2, the first-person model has its own 0..0.1 depth band.
    if (raw <= 0.100001) raw = min(raw*10,0.999999);
    return nearFar.x*nearFar.y/(nearFar.y-raw*(nearFar.y-nearFar.x));
}
bool WorldPos(int2 px,float raw,out float3 p) {
    float2 uv=(float2(px)+0.5)/texel.xy;
    float z=ViewDistance(raw);
    p=float3((uv.x*2-1)*z*inverseProjection[0][0],(1-uv.y*2)*z*inverseProjection[1][1],z);
    return raw<0.999999 && p.z>0 && p.z<20000;
}
#define AFX_PASS_DEPTH_TYPE sampler
#include "afx_pass_normals.hlsli"
struct Input { float2 uv : TEXCOORD0; };
float4 main(Input i) : COLOR {
    int2 px=int2(i.uv*texel.xy);
    float raw=LoadRaw(depthTex,px);
    float dist=ViewDistance(raw);
    if (passParams.y>0.5 && passParams.y<1.5 && raw>0.100001) return float4(0,0,0,1);
    if (passParams.y>1.5) {
        float reference=LoadRaw(worldDepthTex,px);
        float world=ViewDistance(reference);
        if (raw>=0.999999 || world-dist <= max(0.02,world*0.00001)) return float4(0,0,0,1);
    }
    if (passParams.x<0.5) {
        float gray=raw>=0.999999 ? 0 : saturate((dist-nearFar.z)/(nearFar.w-nearFar.z));
        return float4(gray,gray,gray,1);
    }
    bool valid;
    float3 n=SmoothNormal(depthTex,px,valid);
    return float4(valid ? n*0.5+0.5 : float3(0,0,0),1);
}
