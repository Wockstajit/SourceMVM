// afx_render_pass_ps_5_0: the render-pass compositor (Filmmaker multipass capture).
//
// Turns one physical render into the frame a pass stream records:
//   mode 0 Beauty  -- colour, optionally matted onto the key colour
//   mode 1 Depth   -- linear grayscale camera depth (distance along the view axis), white at
//                     `nearFar.x`, black at `nearFar.y`
//   mode 2 Normal  -- view-space surface normal reconstructed from depth, RGB = n * 0.5 + 0.5
//                     (+X right = red, +Y up = green, +Z toward the camera = blue)
//   mode 3 Key     -- the isolated subject in its own colour over the key colour (green screen):
//                     the colour plate of Players only and Gun only, which have no Beauty
//   mode 4         -- diagnostic: the raw depth sample (r + g/255 + b/65025)
// and the subject mask:
//   mask 0 None     -- the whole render
//   mask 1 ColorKey -- pixels painted with the internal chroma key, and the sky, are background
//   mask 2 GunDiff  -- the gun in a render job: pixels in the viewmodel depth band of the reference
//                      render (Main), plus, near that band, pixels where Main differs from this
//                      render (NoGun) -- the muzzle flash and first-person particles; colour and
//                      depth then come from the reference. Depth and Normal take the band alone
//   mask 4 GunBand  -- the gun in the live view, from one render: its viewmodel depth band
//   mask 3 PlayersDepth -- Players only in a render job, taken from the NoGun render: the subject
//                      is what is CLOSER than the World Only render of the same frame (t4). Props,
//                      wires, decals and lighting all sit AT world depth, so they are background
//                      and the plate's background is exactly the key colour.
//
// DEPTH (measured 2026-09-26, cs_office): CS2's raw depth is NOT a single projection. The world is
// drawn into the viewport depth range [depthRange.x, depthRange.y] (forward or reversed, detected
// on the CPU from the projection), and the first-person viewmodel into the band below it
// ([0, depthRange.x) forward; raw ~0.094 on a pistol) with its own projection. The world is
// unprojected exactly like the Environment renderer does it: normalise into the viewport range,
// then the inverse world-to-clip. The viewmodel band is normalised into [0, 1] and unprojected with
// the same inverse -- its depth is right to within its (different, narrower) field of view.
//
// t0 = this render's colour   t1 = this render's raw depth (sample 0, R32F or R24)
// t2 = reference colour        t3 = reference raw depth
// Pairs with afx_drawtexture_vs_5_0 (screen-space pass-through).

cbuffer PS_CONSTANT_BUFFER : register(b0)
{
	int4 modeMask;        // x = mode, y = mask
	float4 keyIn;         // rgb = internal chroma key, a = match tolerance
	float4 keyOut;        // rgb = output background colour
	float4 nearFar;       // x = near units (white), y = far units (black), z = sky cutoff units
	float4 camera;        // xyz = camera world position, w = 1 when depth is reversed
	float4 depthRange;    // x = world viewport min depth, y = max depth
	float4 forward;       // xyz = camera forward (world)
	float4 right;         // xyz = camera right (world)
	float4 up;            // xyz = camera up (world)
	float4 invViewProj0;  // inverse world-to-clip, rows
	float4 invViewProj1;
	float4 invViewProj2;
	float4 invViewProj3;
	float4 texel;         // xy = 1 / size, zw = size in pixels
	float4 diff;          // x = diff threshold low, y = high (0..1 colour units), z = 1: target is sRGB
};

Texture2D<float4> colorTex : register(t0);
Texture2D<float> depthTex : register(t1);
Texture2D<float4> refColorTex : register(t2);
Texture2D<float> refDepthTex : register(t3);
Texture2D<float> worldDepthTex : register(t4);

struct PS_INPUT
{
	float4 xyzw : SV_POSITION;
	float2 t0 : TEXCOORD0;
};

float4 MulRows(float4 v)
{
	return float4(dot(invViewProj0, v), dot(invViewProj1, v), dot(invViewProj2, v), dot(invViewProj3, v));
}

// Raw sample -> projection depth in [0, 1] of the projection that drew it. -1 = sky / 3D skybox.
float ProjectionDepth(float raw)
{
	float span = max(depthRange.y - depthRange.x, 1e-12);
	if (camera.w > 0.5) {
		// Reversed: sky clears to 0, the world occupies [min, max] with near at max, and the
		// viewmodel band lies above max.
		if (raw < 1e-7) return -1.0;
		if (raw > depthRange.y) return saturate((raw - depthRange.y) / max(1.0 - depthRange.y, 1e-7));
		if (raw < depthRange.x) return -1.0;
		return saturate((raw - depthRange.x) / span);
	}
	// Forward: sky clears to 1, the viewmodel band lies below min.
	if (raw > 0.9999999) return -1.0;
	if (raw < depthRange.x) return saturate(raw / max(depthRange.x, 1e-7));
	if (raw > depthRange.y) return -1.0;
	return saturate((raw - depthRange.x) / span);
}

// World position of pixel `px` at a raw depth; false for the sky.
bool WorldPos(int2 px, float raw, out float3 p)
{
	float d = ProjectionDepth(raw);
	p = camera.xyz;
	if (d < 0.0) return false;
	float2 uv = (float2(px) + 0.5) * texel.xy;
	float4 h = MulRows(float4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, d, 1.0));
	if (abs(h.w) < 1e-12) return false;
	p = h.xyz / h.w;
	return true;
}

float LoadRaw(Texture2D<float> t, int2 px)
{
	int2 size = int2(texel.zw);
	px = clamp(px, int2(0, 0), size - 1);
	return t.Load(int3(px, 0));
}

// Distance along the view axis; huge for the sky.
float CameraDepth(Texture2D<float> t, int2 px)
{
	float3 p;
	if (!WorldPos(px, LoadRaw(t, px), p)) return 1e30;
	return dot(p - camera.xyz, forward.xyz);
}

#define AFX_PASS_DEPTH_TYPE Texture2D<float>
#include "afx_pass_normals.hlsli"

// The first-person viewmodel's own depth band: CS2 draws it at raw depth <= 0.1 (a pistol ~0.094;
// the same limit the depth of field uses, LensFxShaders.h ViewDistance). Not "below depthRange.x":
// the viewport range the compositor is handed starts at 0 in the live view (measured 2026-10-17,
// depthRange=(0, 0.95)), and the gun then matched nothing. World geometry only reaches 0.1 within
// a few units of the near plane. Reversed depth keeps the band above the world range.
static const float kViewmodelDepthMax = 0.100001;
bool ViewmodelBand(float raw)
{
	if (camera.w > 0.5) return raw > depthRange.y + 1e-7;
	return raw <= max(depthRange.x, kViewmodelDepthMax);
}

// Whether the reference render's viewmodel band lies within `radius` pixels of `px`: 16 directions
// at 8 distances from radius/11 to radius, each ring turned half a step against the last.
bool NearViewmodelBand(int2 px, float radius)
{
	[loop] for (int r = 0; r < 8; ++r) {
		float dist = radius * exp2(((float)r - 7.0) * 0.5);
		[loop] for (int a = 0; a < 16; ++a) {
			float ang = ((float)a + 0.5 * (float)(r & 1)) * 0.39269908;
			int2 q = px + int2(round(float2(cos(ang), sin(ang)) * dist));
			if (ViewmodelBand(LoadRaw(refDepthTex, q))) return true;
		}
	}
	return false;
}

float4 ComposePixel(PS_INPUT i);

// An sRGB target encodes on write; what we output is already display-encoded, so decode it first.
float4 main(PS_INPUT i) : SV_TARGET
{
	float4 c = ComposePixel(i);
	if (diff.z > 0.5) {
		float3 lo = c.rgb / 12.92;
		float3 hi = pow(max((c.rgb + 0.055) / 1.055, 0.0), 2.4);
		c.rgb = lerp(hi, lo, step(c.rgb, 0.04045));
	}
	return c;
}

float4 ComposePixel(PS_INPUT i)
{
	int2 px = int2(i.xyzw.xy);
	int mode = modeMask.x;
	int mask = modeMask.y;

	float4 col = colorTex.Load(int3(px, 0));
	float subject = 1.0;
	bool useRef = false;
	if (mask == 3) {
		// Closer than the world by more than depth noise (relative, so distant players count too).
		// The sky is world-less in both renders and never closer, so it is background as well.
		float here = CameraDepth(depthTex, px);
		float world = CameraDepth(worldDepthTex, px);
		subject = (here < 1e29 && here < world - max(1.5, world * 0.004)) ? 1.0 : 0.0;
	} else if (mask == 1) {
		// Background = the chroma-painted scene, or the sky: the players render repaints only scene
		// materials, and the sky dome (a separate env_sky path) keeps its colour, so it is keyed by
		// depth -- nothing a player can be sits past the sky cutoff.
		// The match is on HUE, not RGB distance: the chroma-painted world still goes through the
		// engine's exposure, lighting and vignette, which change only its BRIGHTNESS (measured on a
		// players plate: R = B = 0 everywhere, G from 0.46 to 0.95). Dividing by the brightest
		// channel removes that, so every shade of the key reads as background.
		float cm = max(max(col.r, col.g), col.b);
		float km = max(max(keyIn.r, keyIn.g), keyIn.b);
		float3 dk = abs(col.rgb / max(cm, 1e-4) - keyIn.rgb / max(km, 1e-4));
		bool keyed = cm > 0.02 && max(max(dk.r, dk.g), dk.b) <= keyIn.a;
		bool sky = CameraDepth(depthTex, px) > nearFar.z;
		subject = (keyed || sky) ? 0.0 : 1.0;
	} else if (mask == 2) {
		// The gun's depth band makes it the subject whatever its colour. The colour difference alone
		// keyed out every part of the gun as bright as what is behind it: grey sleeve and barrel
		// highlights over grey smoke came out key green (2026-10-17). The difference still brings
		// what the gun CAUSES outside its band: the muzzle flash, first-person particles. Those
		// start at the gun, so the difference counts only near the band: the two renders of a
		// frame also differ wherever the world sways on its own clock (foliage, cables, cloth),
		// which keyed scattered world edges into the plate (de_inferno, 2026-10-24).
		// Depth and Normal take the band alone: a muzzle flash has no depth of its own, so its
		// pixels carried the wall behind it into the gun's depth as white specks.
		float4 ref = refColorTex.Load(int3(px, 0));
		if (ViewmodelBand(LoadRaw(refDepthTex, px))) {
			subject = 1.0;
		} else if (mode == 0 || mode == 3) {
			float3 dc = abs(ref.rgb - col.rgb);
			subject = smoothstep(diff.x, diff.y, max(max(dc.r, dc.g), dc.b));
			if (subject > 0.0 && !NearViewmodelBand(px, texel.w * 0.15)) subject = 0.0;
		} else {
			subject = 0.0;
		}
		col = ref;
		useRef = true;
	} else if (mask == 4) {
		// Live gun view: one render, so only the band (no muzzle flash, which needs the second render).
		subject = ViewmodelBand(LoadRaw(depthTex, px)) ? 1.0 : 0.0;
	}

	if (mode == 0 || mode == 3) {
		return float4(lerp(keyOut.rgb, col.rgb, subject), 1.0);
	}

	if (mode == 4) {
		float raw = useRef ? LoadRaw(refDepthTex, px) : LoadRaw(depthTex, px);
		float r = floor(raw * 255.0) / 255.0;
		float g = floor((raw - r) * 65025.0) / 255.0;
		float bb = frac((raw - r) * 65025.0);
		return float4(r, g, bb, 1.0);
	}

	if (subject < 0.5) return float4(0.0, 0.0, 0.0, 1.0);

	if (mode == 1) {
		float dist = useRef ? CameraDepth(refDepthTex, px) : CameraDepth(depthTex, px);
		float range = max(nearFar.y - nearFar.x, 1e-3);
		float g = saturate(1.0 - (dist - nearFar.x) / range);
		return float4(g, g, g, 1.0);
	}

	// mode 2: normals. Sky has no surface.
	bool valid;
	float3 n = useRef ? SmoothNormal(refDepthTex, px, valid) : SmoothNormal(depthTex, px, valid);
	if (!valid) return float4(0.0, 0.0, 0.0, 1.0);
	return float4(n * 0.5 + 0.5, 1.0);
}
