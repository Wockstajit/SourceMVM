{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "toolset": "v143",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "AFX_RUST_CARGO_LOCKED": "TRUE"
      }
    },
    {
      "name": "win32-debug",
      "inherits": "base",
      "architecture": "Win32",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "win32-release",
      "inherits": "base",
      "architecture": "Win32",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "x64-debug",
      "inherits": "base",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AFX_SOURCE2_ONLY": "FALSE"
      }
    },
    {
      "name": "x64-release",
      "inherits": "base",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AFX_SOURCE2_ONLY": "FALSE"
      }
    },
    {
      "name": "x64-source2-debug",
      "inherits": "base",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AFX_SOURCE2_ONLY": "TRUE"
      }
    },
    {
      "name": "x64-source2-release",
      "inherits": "base",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AFX_SOURCE2_ONLY": "TRUE"
      }
    },
    {
      "name": "x64-deadlock-release",
      "displayName": "x64 Deadlock Release",
      "description": "Deadlock hook DLL (AfxHookDeadlock) plus the CS2 hook it shares code with.",
      "inherits": "base",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AFX_SOURCE2_ONLY": "TRUE",
        "AFX_DEADLOCK": "TRUE"
      }
    },
    {
      "name": "x64-deadlock-debug",
      "displayName": "x64 Deadlock Debug",
      "description": "Deadlock hook DLL (AfxHookDeadlock) plus the CS2 hook it shares code with.",
      "inherits": "base",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AFX_SOURCE2_ONLY": "TRUE",
        "AFX_DEADLOCK": "TRUE"
      }
    },
    {
      "name": "x64-deadlock-ninja-release",
      "displayName": "x64 Deadlock Release (Ninja)",
      "description": "Same targets as x64-deadlock-release, built with Ninja so a compiler cache such as sccache can wrap cl.exe. Configure it from an x64 Visual Studio developer prompt.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "AFX_RUST_CARGO_LOCKED": "TRUE",
        "AFX_SOURCE2_ONLY": "TRUE",
        "AFX_DEADLOCK": "TRUE",
        "AFX_MSVC_RELEASE_DEBUG_INFO": "/Z7"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win32-debug",
      "configurePreset": "win32-debug",
      "configuration": "Debug"
    },
    {
      "name": "win32-release",
      "configurePreset": "win32-release",
      "configuration": "Release"
    },
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "configuration": "Release"
    },
    {
      "name": "x64-source2-debug",
      "configurePreset": "x64-source2-debug",
      "configuration": "Debug"
    },
    {
      "name": "x64-source2-release",
      "configurePreset": "x64-source2-release",
      "configuration": "Release"
    },
    {
      "name": "x64-deadlock-release",
      "configurePreset": "x64-deadlock-release",
      "configuration": "Release"
    },
    {
      "name": "x64-deadlock-debug",
      "configurePreset": "x64-deadlock-debug",
      "configuration": "Debug"
    },
    {
      "name": "x64-deadlock-ninja-release",
      "configurePreset": "x64-deadlock-ninja-release"
    }
  ]
}
